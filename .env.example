# =====================================================================
# TransformAI - Environment Variables Configuration
# =====================================================================

# 1. AI Engine Configuration
# Provide your OpenAI API Key for GPT-5.6 / GPT-4o execution.
# If left empty, TransformAI automatically runs in high-fidelity "DEMO MODE"
# with full local offline simulation and sample cybersecurity scenarios.
OPENAI_API_KEY=

# OpenAI Model identifier (defaults to gpt-4o or gpt-5.6 if available in your tier)
OPENAI_MODEL=gpt-4o

# 2. Database Configuration
# PostgreSQL connection string:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Default local/docker: postgresql://transformai:transformai_secret@localhost:5432/transformai
# NOTE: If PostgreSQL is offline, TransformAI automatically falls back to local SQLite (transformai.db)
DATABASE_URL=postgresql://transformai:transformai_secret@localhost:5432/transformai

# 3. Cache & Task Management Configuration
# Redis connection string:
# Format: redis://<host>:<port>/0
# Default local/docker: redis://localhost:6379/0
# NOTE: If Redis is offline, TransformAI automatically uses an in-memory TTL task manager
REDIS_URL=redis://localhost:6379/0

# 4. Frontend & API Configuration
# URL of the FastAPI Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
